PORT=
CORS_ORIGIN=
NODE_ENV=

# Tells the assistant how to behave and what it is allowed to talk about.
# Leave empty to use the market-assistant prompt built into src/config/index.js.
SYSTEM_PROMPT=

# AWS credentials should be provided through AWS CLI/SSO or an IAM role, never stored here.
AWS_REGION=
BEDROCK_MODEL_ID=
BEDROCK_MAX_TOKENS=
BEDROCK_TEMPERATURE=
BEDROCK_REQUEST_TIMEOUT_MS=

# Langfuse tracing. Optional — leave the keys empty to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Bedrock Knowledge Base for document search.
# Optional — leave KNOWLEDGE_BASE_ID empty to run without the search_documents tool.
KNOWLEDGE_BASE_ID=
RAG_TOP_K=

# Bedrock Guardrail. Optional — leave GUARDRAIL_ID empty to run without it.
# GUARDRAIL_VERSION must be a published version number (1, 2, ...), not DRAFT.
GUARDRAIL_ID=
GUARDRAIL_VERSION=
